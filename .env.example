# ============================================
# DATABASE (PostgreSQL)
# ============================================
# The connection string for the development database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# The password lives only in this file (git-ignored) and is never printed,
# logged, or committed. Do not put a real credential in .env.example.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/masjid_collection"

# Optional. The database `prisma migrate dev` uses to replay migrations and
# detect drift. When it is absent, Prisma creates and drops a temporary
# shadow database instead, which requires the role above to hold CREATEDB.
# SHADOW_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/masjid_collection_shadow"

# Required to run the automated test suite. Must point at a dedicated
# database whose name contains "test" — the test bootstrap refuses to run
# against anything else.
# TEST_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/masjid_collection_test"

# ============================================
# SEED — the two administrator accounts
# ============================================
# `npm run seed` creates exactly two accounts: a Super Admin and a Local
# Masjid Admin bound to one test masjid. The passwords have NO defaults and
# are never printed. Set them before running the seed.
SEED_SUPER_ADMIN_EMAIL="platform-admin@example.invalid"
SEED_SUPER_ADMIN_PASSWORD=""
SEED_SUPER_ADMIN_NAME="Platform Super Admin"

SEED_LOCAL_ADMIN_EMAIL="masjid-admin@example.invalid"
SEED_LOCAL_ADMIN_PASSWORD=""
SEED_LOCAL_ADMIN_NAME="Masjid Admin"

# The single test masjid both accounts are attached to.
SEED_TEST_MASJID_NAME="Test Masjid"
SEED_TEST_MASJID_SLUG="test-masjid"
SEED_TEST_MASJID_RECEIPT_PREFIX="TSTM"
# SEED_TEST_MASJID_ADDRESS=""

# ============================================
# APP
# ============================================
# Signing key for the session cookie. Must be at least 32 characters.
# `npm run preflight` generates one automatically on a fresh checkout.
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# TELEGRAM BOT (FREE - PRIMARY NOTIFICATION CHANNEL)
# ============================================
# 1. Message @BotFather on Telegram
# 2. Send /newbot
# 3. Name: "Masjid Collection Bot"
#    Username: "yourmasjidbot" (must end with 'bot')
# 4. Copy the token
TELEGRAM_BOT_TOKEN=""

# For channel broadcasts (announcements to all members):
# 1. Create a Telegram Channel
# 2. Add your bot as Admin (with "Post Messages" permission)
# 3. Forward any message from channel to @userinfobot to get Channel ID
#    (looks like: -1001234567890)
TELEGRAM_CHANNEL_ID=""

# ============================================
# EMAIL (OPTIONAL - FREE via Gmail/Outlook/Zoho SMTP)
# ============================================
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT="587"
# EMAIL_USER="your-email@gmail.com"
# EMAIL_PASS="your-app-password"  # Not your login password! Use App Password
# EMAIL_FROM="Masjid Collection <noreply@yourmasjid.org>"

# ============================================
# WHATSAPP (OPTIONAL - REQUIRES META VERIFICATION, PAID BSP)
# ============================================
# WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# WHATSAPP_ACCESS_TOKEN="EAAxxxxxxxxxxxx"
# WHATSAPP_API_VERSION="v21.0"
