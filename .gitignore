# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log

# env files — keep the example, never a real secret
.env
.env.*
!.env.example

# local data: the SQLite database, test copies and backups
/data/
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
