{
  "name": "masjid-collection",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preflight": "node scripts/prepare.mjs",
    "predev": "npm run preflight",
    "dev": "next dev",
    "prestart": "npm run preflight",
    "start": "next start",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset-test": "tsx scripts/reset-test-db.ts",
    "seed": "tsx prisma/seed.ts",
    "setup": "npm run preflight && prisma migrate deploy && prisma generate && tsx prisma/seed.ts",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "restore": "node scripts/restore.mjs",
    "restore:test": "node scripts/test-restore.mjs",
    "dr:rehearsal": "npm run backup && npm run restore:test",
    "test": "vitest run"
  },
  "dependencies": {
    "@paddle/paddle-node-sdk": "^1.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/qrcode": "^1.5.6",
    "@vercel/config": "^0.14.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "regenerator-runtime": "^0.14.1",
    "stripe": "^16.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
